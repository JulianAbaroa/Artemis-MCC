			<subtype name="Mongoose" id="6" />
			<subtype name="OniVan" id="7" />
			<subtype name="Pickup" id="8" />
			<subtype name="Revenant" id="9" />
			<subtype name="Sabre" id="10" />
			<subtype name="Scorpion" id="11" />
			<subtype name="Seraph" id="12" />
			<subtype name="TruckCab" id="13" />
			<subtype name="TruckCabBedLong" id="14" />
			<subtype name="Warthog" id="15" />
			<subtype name="WarthogTroop" id="16" />
			<subtype name="Wraith" id="17" />
		</value>
		<value name="Turret" id="3" group="Mobility" doc="Vehicle object that holds a seat and a mounted weapon (vehi -> vehi -> weap).">
			<subtype name="FalconChinGun" id="1" />
			<subtype name="FalconGrenadeLeft" id="2" />
			<subtype name="FalconGrenadeRight" id="3" />
			<subtype name="FalconSensor" id="4" />
			<subtype name="FalconTurretLeft" id="5" />
			<subtype name="FalconTurretRight" id="6" />
			<subtype name="RevenantPlasmaTurret" id="7" />
			<subtype name="ScorpionCannon" id="8" />
			<subtype name="ScorpionTurret" id="9" />
			<subtype name="Shade" id="10" />
			<subtype name="ShadeFlakCannon" id="11" />
			<subtype name="ShadePlasmaCannon" id="12" />
			<subtype name="VehicleMountedPlasmaTurret" id="13" />
			<subtype name="WarthogChaingun" id="14" />
			<subtype name="WarthogGauss" id="15" />
			<subtype name="WarthogRocket" id="16" />
			<subtype name="WraithCannon" id="17" />
			<subtype name="WraithPlasmaTurret" id="18" />
		</value>
		<value name="Weapon" id="4" group="Item" doc="Hand weapon, or the weapon mounted on a vehicle or turret (subtype Mounted / Horn).">
			<subtype name="AssaultRifle" id="1" />
			<subtype name="ConcussionRifle" id="2" />
			<subtype name="DMR" id="3" />
			<subtype name="EnergySword" id="4" />
			<subtype name="FocusRifle" id="5" />
			<subtype name="FuelRod" id="6" />
			<subtype name="GravityHammer" id="7" />
			<subtype name="GrenadeLauncher" id="8" />
			<subtype name="Machinegun" id="9" />
			<subtype name="Magnum" id="10" />
			<subtype name="MountedPlasmaTurret" id="11" />
			<subtype name="NeedleRifle" id="12" />
			<subtype name="Needler" id="13" />
			<subtype name="PlasmaLauncher" id="14" />
			<subtype name="PlasmaPistol" id="15" />
			<subtype name="PlasmaRepeater" id="16" />
			<subtype name="PlasmaRifle" id="17" />
			<subtype name="PlasmaTurret" id="18" />
			<subtype name="RocketLauncher" id="19" />
			<subtype name="Shotgun" id="20" />
			<subtype name="SniperRifle" id="21" />
			<subtype name="SpartanLaser" id="22" />
			<subtype name="Spiker" id="23" />
			<subtype name="Mounted" id="24" />
			<subtype name="Horn" id="25" />
		</value>
		<value name="ObjectiveItem" id="5" group="Item" doc="Item of a game mode: flag, bomb, ball.">
			<subtype name="Flag" id="1" />
			<subtype name="Bomb" id="2" />
			<subtype name="Ball" id="3" />
		</value>
		<value name="ArmorAbility" id="6" group="Item" doc="Armor ability.">
			<subtype name="Sprint" id="1" />
			<subtype name="Jetpack" id="2" />
			<subtype name="Hologram" id="3" />
			<subtype name="Evade" id="4" />
			<subtype name="DropShield" id="5" />
			<subtype name="ArmorLock" id="6" />
			<subtype name="ActiveCamo" id="7" />
