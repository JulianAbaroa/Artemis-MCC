		<value name="Grenade" id="7" group="Item" doc="Grenade lying in the world.">
			<subtype name="Frag" id="1" />
			<subtype name="Plasma" id="2" />
		</value>
		<value name="AmmoPack" id="8" group="Item" doc="Ammo pickup or ammo cabinet.">
			<subtype name="AmmoCabinet" id="1" />
			<subtype name="RocketAmmo" id="2" />
			<subtype name="SniperAmmo" id="3" />
		</value>
		<value name="Powerup" id="9" group="Item" doc="Powerup.">
			<subtype name="Red" id="1" />
			<subtype name="Blue" id="2" />
			<subtype name="Yellow" id="3" />
		</value>
		<value name="Projectile" id="10" group="Hazard" doc="Projectile in flight." />
		<value name="Explosive" id="11" group="Hazard" doc="Object that explodes when destroyed.">
			<subtype name="FusionCoil" id="1" />
			<subtype name="Landmine" id="2" />
			<subtype name="PlasmaBattery" id="3" />
			<subtype name="PropaneTank" id="4" />
		</value>
		<value name="SpawnPoint" id="12" group="MapLogic" doc="Point where players spawn.">
			<subtype name="Initial" id="1" />
			<subtype name="Respawn" id="2" />
			<subtype name="Invisible" id="3" />
		</value>
		<value name="SpawnZone" id="13" group="MapLogic" doc="Volume that weights where players respawn.">
			<subtype name="Normal" id="1" />
			<subtype name="Weak" id="2" />
			<subtype name="Anti" id="3" />
			<subtype name="Fireteam1" id="4" />
			<subtype name="Fireteam2" id="5" />
			<subtype name="Fireteam3" id="6" />
			<subtype name="Fireteam4" id="7" />
		</value>
		<value name="Boundary" id="14" group="MapLogic" doc="Safe or kill volume.">
			<subtype name="Safe" id="1" />
			<subtype name="SoftSafe" id="2" />
			<subtype name="Kill" id="3" />
			<subtype name="SoftKill" id="4" />
		</value>
		<value name="DangerZone" id="15" group="MapLogic" doc="Volume marked as dangerous." />
		<value name="LocationArea" id="16" group="MapLogic" doc="Named area (callouts)." />
		<value name="ObjectiveSpawn" id="17" group="MapLogic" doc="Where an objective spawns or is delivered.">
			<subtype name="FlagStand" id="1" />
			<subtype name="CapturePlate" id="2" />
			<subtype name="BallSpawn" id="3" />
		</value>
		<value name="ObjectiveZone" id="18" group="MapLogic" doc="Area that is itself the objective.">
			<subtype name="Hill" id="1" />
			<subtype name="Territory" id="2" />
			<subtype name="FlagCapture" id="3" />
		</value>
		<value name="Teleporter" id="19" group="MapLogic" doc="Teleporter.">
			<subtype name="Sender" id="1" />
			<subtype name="Receiver" id="2" />
			<subtype name="TwoWay" id="3" />
		</value>
		<value name="Lift" id="20" group="MapLogic" doc="Man cannon or gravity lift.">
			<subtype name="Vertical" id="1" />
			<subtype name="Curved" id="2" />
			<subtype name="Redirected" id="3" />
		</value>
		<value name="Barrier" id="21" group="MapLogic" doc="Energy door, wall or shield.">
			<subtype name="OneWay" id="1" />
			<subtype name="TwoWay" id="2" />
			<subtype name="Blocker" id="3" />
			<subtype name="DropShield" id="4" />
			<subtype name="Portable" id="5" />
		</value>
		<value name="HealthStation" id="22" group="MapLogic" doc="Health station." />
		<value name="Device" id="23" group="Scenery" doc="Machine or control without another role." />
		<value name="Prop" id="24" group="Scenery" doc="Physical object without a game role." />
		<value name="Decor" id="25" group="Scenery" doc="Object without a game role nor collision.">
			<subtype name="Sky" id="1" />
			<subtype name="Effect" id="2" />
			<subtype name="Sound" id="3" />
		</value>
		<value name="CameraMarker" id="26" group="Scenery" doc="Cinematic camera position." />
		<value name="Decoy" id="27" group="Actor" doc="Biped without a player that imitates one (hologram).">
			<subtype name="Hologram" id="1" />
		</value>
	</enum>
	<enum name="Lifecycle" type="uint8" doc="Whether the object is alive.">
		<value name="Active" id="0" />
		<value name="Dead" id="1" />
	</enum>
	<enum name="Binding" type="uint8" doc="Link of the object to its parent.">
		<value name="Free" id="0" />
		<value name="Carried" id="1" />
		<value name="Seated" id="2" />
		<value name="Attached" id="3" />
	</enum>
	<enum name="Physics" type="uint8" doc="Forge physics of the living object, read from its placement in the map variant (None = no placement).">
		<value name="None" id="0" />
		<value name="Normal" id="1" />
		<value name="Fixed" id="2" />
		<value name="Phased" id="3" />
	</enum>
	<enum name="Relation" type="uint8" doc="Relation of an entity with an agent.">
		<value name="Neutral" id="0" />
		<value name="Self" id="1" />
		<value name="Ally" id="2" />
		<value name="Enemy" id="3" />
	</enum>
	<enum name="Event" type="uint8" doc="Kind of an event of the tick.">
		<value name="Kill" id="0" />
		<value name="Death" id="1" />
		<value name="Spawn" id="2" />
		<value name="Damage" id="3" />
		<value name="Pickup" id="4" />
		<value name="Drop" id="5" />
		<value name="Fire" id="6" />
		<value name="AbilityUsed" id="7" />
		<value name="Teleported" id="8" />
		<value name="Score" id="9" />
		<value name="Suicide" id="10" />
		<value name="GameOver" id="11" />
		<value name="Medal" id="12" doc="Engine key outside the statistics category without a kind of its own (medals, incidents)." />
		<value name="Stat" id="13" doc="Engine key of the statistics category without a kind of its own." />
		<value name="FlagTaken" id="14" />
		<value name="FlagDropped" id="15" />
		<value name="FlagReturned" id="16" doc="Returned by the presence of its team." />
		<value name="FlagReset" id="17" doc="Back to its stand by the timer." />
		<value name="FlagCaptured" id="18" />
		<value name="RoundEnd" id="19" doc="A round ended and another one follows. The last round ends with GameOver instead." />
		<value name="RoundStart" id="20" doc="One per player, about 11 s after RoundEnd." />
	</enum>
	<enum name="MatchPhase" type="uint8" doc="Phase of the match (D103).">
		<value name="Unknown" id="0" />
		<value name="InGame" id="1" />
		<value name="Ended" id="2" doc="After the end of a round (until the next one starts) or of the match." />
	</enum>
	<flags name="Capability" type="uint16" doc="Capabilities of an entity. They never decide the group.">
		<bit name="HasVitality" index="0" />
		<bit name="HasCollision" index="1" />
		<bit name="HasZone" index="2" />
		<bit name="IsPickable" index="3" />
		<bit name="IsEnterable" index="4" />
		<bit name="IsUsable" index="5" />
		<bit name="IsDestructible" index="6" />
		<bit name="IsDynamic" index="7" />
		<bit name="BlocksMovement" index="8" />
		<bit name="BlocksProjectiles" index="9" />
		<bit name="CanDamage" index="10" />
		<bit name="IsObjective" index="11" />
	</flags>
	<!-- Keys of the event ring of the engine (D104, Q85) and the kind of event each one is. A key that is not listed is Stat when
	     its category (key >> 16) is statcategory and Medal otherwise. Names by evidence until the incident tag names them all. -->
	<eventkeys statcategory="0x78">
		<key value="0x780000" name="Kill" kind="Kill" />
		<key value="0x780002" name="Death" kind="Death" doc="Same data as the kill." />
		<key value="0x780003" name="Suicide" kind="Suicide" doc="Cause and effect are the same player." />
		<key value="0x780008" name="PlayerLeft" kind="Stat" doc="Deletes the statistics of the player." />
		<key value="0x780009" name="PlayerJoined" kind="Stat" />
		<key value="0x78000C" name="GrenadeKill" kind="Stat" doc="Frag and plasma." />
		<key value="0x780018" name="MeleeKill" kind="Stat" />
		<key value="0x780019" name="HeadshotKill" kind="Stat" />
		<key value="0x78001B" name="RoundEnd" kind="RoundEnd" doc="Same tick as the capture that ends a round that is not the last. Resets the counters of the round (A4 5.3)." />
		<key value="0x780022" name="GameOver" kind="GameOver" doc="Every field is -1." />
		<key value="0x780024" name="FirstKill" kind="Stat" />
		<key value="0x780026" name="Spawn" kind="Spawn" doc="Cause = the player, cause object = the new biped." />
		<key value="0x78002F" name="RespawnCountdown" kind="Stat" doc="Once per second of the last seconds of the respawn wait." />
		<key value="0x780030" name="RespawnReady" kind="Stat" />
		<!-- CTF, measured 2026-10-22 (A14, Ignore/Temporal/ctf_events_20261022.csv). Byte +0x11 of the data: team of the flag on take
		     and drop (meaning on the capture still unknown). Some drops carry no player (announcement for every machine). -->
		<key value="0x79E0" name="FlagTaken" kind="FlagTaken" doc="Cause = the carrier and its biped." />
		<key value="0x79EF" name="FlagDropped" kind="FlagDropped" doc="With or without the player (a drop by death has none)." />
		<key value="0x79F2" name="FlagCaptured" kind="FlagCaptured" doc="Cause = the carrier." />
		<key value="0x79F4" name="FlagReset" kind="FlagReset" doc="No player. Byte +0x10 = team." />
		<key value="0x79F6" name="FlagReturned" kind="FlagReturned" doc="No player. Byte +0x10 = team." />
		<key value="0x7A70" name="RoundStart" kind="RoundStart" doc="Cause = each player." />
	</eventkeys>
</semantic>
