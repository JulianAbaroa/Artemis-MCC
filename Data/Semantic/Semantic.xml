<?xml version='1.0' encoding='utf-8'?>
<!-- Single source of the semantic ids of Artemis (Ignore/Semantizacion/05 and 07). Ids are stable: only append, never renumber or reuse.
     Tools/TagTranspiler/GenerateSemantic.py generates the C++ (Common.Semantic.Type) and validates Data/Tags/ObjectTags.xml against it. -->
<semantic>
	<enum name="Group" type="uint8" doc="Consumption group of a function. The order is the precedence.">
		<value name="Unknown" id="0" />
		<value name="Actor" id="1" />
		<value name="Mobility" id="2" />
		<value name="Item" id="3" />
		<value name="Hazard" id="4" />
		<value name="MapLogic" id="5" />
		<value name="Scenery" id="6" />
	</enum>
	<enum name="Function" type="uint8" doc="Role of an object in the match. Stable for the whole life of the object.">
		<value name="Unknown" id="0" group="Unknown" doc="Not classifiable. Visible and counted, never dropped." />
		<value name="Combatant" id="1" group="Actor" doc="Body of a player, alive or dead.">
			<subtype name="Spartan" id="1" />
			<subtype name="Elite" id="2" />
			<subtype name="Monitor" id="3" />
		</value>
		<value name="Vehicle" id="2" group="Mobility" doc="Drivable vehicle.">
			<subtype name="Banshee" id="1" />
			<subtype name="CartElectric" id="2" />
