    <field name="headshot_immunity" offset="0x06" type="u8" enum="bool_trait" />
    <field name="shield_vampirism" offset="0x07" type="u8" enum="vampirism_rate" />
    <field name="assassination_immunity" offset="0x08" type="u8" enum="bool_trait" />
    <field name="cannot_die_from_damage" offset="0x09" type="u8" enum="bool_trait" />
