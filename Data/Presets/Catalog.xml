  <group name="general" doc="Rounds, time and teams of the match.">
    <field name="teams_enabled" offset="0x2BC" type="bit" bit="3" when="load" doc="Bit position taken from ReachVariantTool, not measured." />
    <field name="rounds_to_win" offset="0x2BD" type="u8" when="round_end" />
    <field name="time_limit_minutes" offset="0x2BE" type="u8" when="round_start" unit="min" doc="0 is no limit." />
    <field name="round_limit" offset="0x2BF" type="u8" when="round_end" />
    <field name="sudden_death_seconds" offset="0x2C0" type="s16" when="round_end" unit="s" doc="-1 is indefinite." />
    <field name="grace_period_seconds" offset="0x2C2" type="u16" when="load" unit="s" doc="Not measured, so load only." />
  </group>
  <group name="respawn" doc="Respawn and lives.">
    <field name="sync_with_team" offset="0x2C4" type="bit" bit="0" when="load" doc="Not measured, so load only." />
    <field name="respawn_on_kills" offset="0x2C4" type="bit" bit="3" when="load" doc="Not measured, so load only." />
    <field name="lives_per_round" offset="0x2C5" type="u8" when="spawn" doc="0 is unlimited." />
    <field name="team_lives_per_round" offset="0x2C6" type="u8" when="spawn" doc="0 is unlimited." />
    <field name="time_seconds" offset="0x2C7" type="u8" when="spawn" unit="s" />
    <field name="suicide_penalty" offset="0x2C8" type="u8" when="spawn" unit="s" />
    <field name="betrayal_penalty" offset="0x2C9" type="u8" when="spawn" unit="s" />
    <field name="growth" offset="0x2CA" type="u8" when="spawn" doc="Respawn time growth." />
    <field name="loadout_camera_seconds" offset="0x2CB" type="u8" when="round_start" unit="s" />
    <field name="traits_duration" offset="0x2CC" type="u8" when="spawn" unit="s" doc="Seconds the respawn traits last." />
  </group>
  <group name="respawn_traits" offset="0x2D0" when="spawn" traits="true" doc="Traits of a player after respawning (the duration is respawn traits_duration)." />
  <group name="social" doc="Friendly fire and team changes.">
    <field name="friendly_fire" offset="0x2FC" type="bit" bit="0" when="tick" />
    <field name="betrayal_booting" offset="0x2FC" type="bit" bit="1" when="load" doc="Bit position taken from ReachVariantTool, not measured." />
    <field name="team_changes" offset="0x2FE" type="u16" enum="team_changes" when="load" doc="Not measured, so load only." />
  </group>
  <group name="map" doc="Map options, weapon and vehicle sets and the duration of the powerups.">
    <field name="grenades" offset="0x300" type="bit" bit="0" when="round_start" />
    <field name="shortcuts" offset="0x300" type="bit" bit="1" when="round_start" />
    <field name="abilities" offset="0x300" type="bit" bit="2" when="round_start" />
    <field name="powerups" offset="0x300" type="bit" bit="3" when="round_start" />
    <field name="turrets" offset="0x300" type="bit" bit="4" when="round_start" />
