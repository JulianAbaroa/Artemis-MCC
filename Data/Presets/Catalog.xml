    <field name="infinite_abilities" offset="0x14" type="u8" enum="bool_trait" />
    <field name="primary_weapon" offset="0x15" type="s8" enum="weapon" />
    <field name="secondary_weapon" offset="0x16" type="s8" enum="weapon" />
    <field name="armor_ability" offset="0x17" type="s8" enum="ability" />
    <field name="movement_speed" offset="0x18" type="u8" enum="movement_speed" />
    <field name="gravity" offset="0x19" type="u8" enum="player_gravity" />
    <field name="vehicle_use" offset="0x1A" type="u8" enum="vehicle_usage" />
    <field name="double_jump" offset="0x1B" type="u8" enum="double_jump" />
    <field name="jump_height" offset="0x1C" type="s32" unit="%" doc="Literal percentage. -1 leaves the base." />
    <field name="active_camo" offset="0x20" type="u8" enum="active_camo" />
    <field name="visible_waypoint" offset="0x21" type="u8" enum="visible_identity" />
