    <field name="weapon_set" offset="0x330" type="s16" enum="weapon_set" when="round_start" />
    <field name="vehicle_set" offset="0x332" type="s16" enum="vehicle_set" when="round_start" />
    <field name="red_duration" offset="0x3B8" type="u8" when="pickup" unit="s" />
    <field name="blue_duration" offset="0x3B9" type="u8" when="pickup" unit="s" />
    <field name="yellow_duration" offset="0x3BA" type="u8" when="pickup" unit="s" />
  </group>
  <group name="base_traits" offset="0x304" when="tick" traits="true" doc="Traits of every player." />
  <group name="red_traits" offset="0x334" when="pickup" traits="true" doc="Traits of the red powerup." />
  <group name="blue_traits" offset="0x360" when="pickup" traits="true" doc="Traits of the blue powerup." />
  <group name="yellow_traits" offset="0x38C" when="pickup" traits="true" doc="Traits of the yellow powerup." />
  <group name="teams" doc="Species and scoring of the teams.">
    <field name="species" offset="0x3BC" type="bit" bit="0" width="3" enum="team_species" when="tick" />
    <field name="team_scoring" offset="0x738" type="u16" enum="team_scoring" when="load" doc="Not measured, so load only." />
  </group>
  <group name="team" offset="0x3C0" when="load" doc="Colors of a team (u32, -1 is the default). Not changeable in game.">
    <index name="index" count="8" stride="0x58" />
    <field name="primary_color" offset="0x48" type="u32" />
    <field name="secondary_color" offset="0x4C" type="u32" />
    <field name="text_color" offset="0x50" type="u32" />
  </group>
  <group name="loadout" offset="0x681" when="spawn" doc="A loadout of a palette (6 palettes of 5 loadouts, 6 bytes each).">
    <index name="palette" count="6" stride="0x1E" />
    <index name="index" count="5" stride="0x6" />
    <field name="visible" offset="0x0" type="u8" />
    <field name="name" offset="0x1" type="u8" doc="Raw index of the name." />
    <field name="primary" offset="0x2" type="s8" enum="weapon" />
    <field name="secondary" offset="0x3" type="s8" enum="weapon" />
    <field name="ability" offset="0x4" type="s8" enum="ability" />
    <field name="grenades" offset="0x5" type="u8" doc="Raw count (0 to 15)." />
  </group>
  <group name="trait_set" offset="0x5DD0" when="tick" traits="true" check="megalo_trait_set" doc="A trait set of the Megalo script. The index has to be below the number of sets of the script.">
    <index name="index" count="16" stride="0x30" />
  </group>
  <group name="megalo" doc="Options of the Megalo script.">
    <field name="score_to_win" offset="0xF840" type="u16" when="tick" doc="0 is none." />
  </group>
</catalog>