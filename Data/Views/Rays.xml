<?xml version='1.0' encoding='utf-8'?>
<!-- Pattern of the perception rays of a View (D311). One row per ray, in the frame of the agent: yaw in degrees from its forward, positive to the
     left, pitch in degrees from the horizontal, positive up, and the range in world units. Tools/TagTranspiler/GenerateViews.py generates
     Views.Raycast.Type:Pattern from it. The rows are a cube (6 faces and 8 corners, range 20). The frame is the heading of the aim on the ground
     plane, with the world up. At most 16 rows (k_ViewRayCount of Views.View.Type). -->
<rays>
	<ray yaw="-90" pitch="0" range="20" doc="right face" />
	<ray yaw="90" pitch="0" range="20" doc="left face" />
	<ray yaw="0" pitch="90" range="20" doc="up face" />
	<ray yaw="0" pitch="-90" range="20" doc="down face" />
	<ray yaw="0" pitch="0" range="20" doc="forward face" />
	<ray yaw="180" pitch="0" range="20" doc="back face" />
	<ray yaw="-45" pitch="35.2643897" range="20" doc="right up forward corner" />
	<ray yaw="-135" pitch="35.2643897" range="20" doc="right up back corner" />
	<ray yaw="-45" pitch="-35.2643897" range="20" doc="right down forward corner" />
	<ray yaw="-135" pitch="-35.2643897" range="20" doc="right down back corner" />
	<ray yaw="45" pitch="35.2643897" range="20" doc="left up forward corner" />
	<ray yaw="135" pitch="35.2643897" range="20" doc="left up back corner" />
	<ray yaw="45" pitch="-35.2643897" range="20" doc="left down forward corner" />
	<ray yaw="135" pitch="-35.2643897" range="20" doc="left down back corner" />
</rays>