    // 'ABTB' read as little endian u32: the region is an Artemis bridge.
    inline constexpr std::uint32_t k_BridgeMagic{ 0x42544241 };

    static_assert(k_MaxPlayers == 16, "Bridge.xml MaxPlayers must match k_MaxPlayers.");

    static_assert(k_MaxObjects == 0x400, "Bridge.xml MaxEntities must match k_MaxObjects.");

    // Tick buffers: Artemis writes the one Python is not reading.
    inline constexpr std::uint32_t k_BridgeTickBuffers{ 2 };

    // Flags, and stands, a tick carries (a capture game has one of each per team: Common.Engine k_MaxTeams).
    inline constexpr std::uint32_t k_BridgeMaxObjectives{ 8 };

    // Live weapons a tick carries: in hand, on the floor or mounted (D254).
    inline constexpr std::uint32_t k_BridgeMaxWeapons{ 0x100 };

    // Live projectiles a tick carries (D254).
    inline constexpr std::uint32_t k_BridgeMaxProjectiles{ 0x100 };

    // Live explosives a tick carries: fusion coils, land mines, plasma batteries, propane tanks (D259).
    inline constexpr std::uint32_t k_BridgeMaxExplosives{ 64 };

    // Live lifts a tick carries: man cannons and gravity lifts (D261).
    inline constexpr std::uint32_t k_BridgeMaxLifts{ 64 };

    // Stages (phantom types that push players or bipeds) a lift carries. The tags have 3 at most (D261).
    inline constexpr std::uint32_t k_BridgeMaxLiftStages{ 3 };

    static_assert(k_MaxTeams == 8, "Bridge.xml MaxTeams must match k_MaxTeams.");

    // Powerups of a game variant (red, blue, yellow): the length of the powerup duration array.
    inline constexpr std::uint32_t k_BridgePowerupCount{ 3 };

    // Bytes of a gametype preset name, with its end zero (Engine.Base.Preset k_MaxPresetNameLength is 31).
    inline constexpr std::uint32_t k_BridgePresetNameSize{ 32 };

    // Newest events of the match a tick carries (D141). Python keeps its cursor by Sequence.
    inline constexpr std::uint32_t k_BridgeMaxTickEvents{ 64 };

    static_assert(k_NoHandle == 0xFFFFFFFF, "Bridge.xml NoHandle must match k_NoHandle.");

    // LocalIndex of a player that is not local.
    inline constexpr std::uint8_t k_BridgeNotLocal{ 255 };

    // Name of the region: prefix + pid of MCC (D136).
    inline constexpr std::string_view k_BridgeRegionPrefix{ "Local\\Artemis.Bridge." };

    // Auto-reset event Artemis sets after it publishes a tick.
    inline constexpr std::string_view k_BridgeTickEventSuffix{ ".Tick" };

    // Auto-reset event Python sets after it publishes the actions of a decision.
    inline constexpr std::string_view k_BridgeActionEventSuffix{ ".Action" };

    // Folder inside %LOCALAPPDATA%\Artemis with one pid.json per open region.
    inline constexpr std::string_view k_BridgeDiscoveryFolder{ "Bridge" };

    // Who controls the scale and the players of the AgentMask (D106).
    enum class BridgeOwner : std::uint8_t
    {
        UI = 0,
        Python = 1,
    };

    // Whether the game waits for the actions (D105).
    enum class BridgeMode : std::uint8_t
    {
        // Never waits. A late decision is applied when it arrives and counted.
        Free = 0,
        // The tick of a decision plus the latency waits for its actions, with a cap.
        Lockstep = 1,
    };

    // State of the engine as Artemis sees it.
    enum class BridgePhase : std::uint8_t
    {
        // No match: menus, lobby or teardown.
        Idle = 0,
        Loading = 1,
        // Ticks are running and decision ticks are published.
        Running = 2,
    };

    // What became of the last RequestPreset (Q97).
    enum class BridgePresetResult : std::uint8_t
    {
        // No request since Artemis loaded.
        NoResult = 0,
        // Taken and waiting for a round break of the match.
        Pending = 1,
        // Written into the live variant between rounds and read back equal.
        Applied = 2,
        // Taken in the lobby: the next start writes it.
        AtLoad = 3,
        // Not applied: the preset changes what only a load can change, a trait set the script lacks, or its files are wrong. The variant and the active preset did not change.
        Rejected = 4,
        // A result this layout does not name.
        Unknown = 5,
    };

    // What the feet of a biped touch (Perception GroundKind, D260).
    enum class BridgeGround : std::uint8_t
    {
        Air = 0,
        // The BSP.
        Static = 1,
        // A living object, such as a forge block or a vehicle.
        Object = 2,
        // Parented to another object, such as a seat.
        Attached = 3,
    };

    // Infinite ammo trait (Blam.Layout InfiniteAmmoMode, D262). 0 is a value outside the table.
    enum class BridgeInfiniteAmmo : std::uint8_t
    {
        Unknown = 0,
        Off = 1,
        On = 2,
        // Infinite ammo without reloading.
        Bottomless = 3,
    };

    // Armor ability usage trait (Blam.Layout AbilityUsageMode, D262).
    enum class BridgeAbilityUsage : std::uint8_t
    {
        Unknown = 0,
        Disabled = 1,
        NotWithObjectives = 2,
        Enabled = 3,
    };

    // Vehicle use trait (Blam.Layout VehicleUseMode, D262).
    enum class BridgeVehicleUse : std::uint8_t
    {
        Unknown = 0,
        Blocked = 1,
        PassengerOnly = 2,
        DriverOnly = 3,
        GunnerOnly = 4,
        NoPassenger = 5,
        NoDriver = 6,
        NoGunner = 7,
        Full = 8,
    };

    // Who sees the waypoint or the name of a player (Blam.Layout IdentityVisibility, D262).
    enum class BridgeIdentityVisibility : std::uint8_t
    {
        Unknown = 0,
        Hidden = 1,
        Allies = 2,
        Everyone = 3,
    };

    // Motion tracker mode trait (Blam.Layout RadarDisplayMode, D262).
    enum class BridgeRadarMode : std::uint8_t
    {
        Unknown = 0,
        Off = 1,
        Allies = 2,
        Normal = 3,
        Enhanced = 4,
    };

    // Custom powerup the engine applies to a player (Common Semantic Subtype Powerup, D263).
    enum class BridgePowerup : std::uint8_t
    {
        NoPowerup = 0,
        Red = 1,
        Blue = 2,
        Yellow = 3,
    };

    // One-shot client requests of a decision (D120).
    enum class BridgeRequest : std::uint8_t
    {
        WeaponSwitch = 0x1,
        GrenadeSwitch = 0x2,
        Zoom = 0x4,
    };

    // Flags of a tick.
    enum class BridgeTickFlag : std::uint32_t
    {
        // The tick had more live objects than MaxEntities.
        EntitiesTruncated = 0x1,
        // The tick had more flags or more stands than MaxObjectives.
        ObjectivesTruncated = 0x2,
        // The tick had more live weapons than MaxWeapons.
        WeaponsTruncated = 0x4,
        // The tick had more live projectiles than MaxProjectiles.
        ProjectilesTruncated = 0x8,
        // The tick had more live explosives than MaxExplosives.
        ExplosivesTruncated = 0x10,
        // The tick had more live lifts than MaxLifts.
        LiftsTruncated = 0x20,
    };

    // Vector of three floats, world units or a direction.
    struct BridgeVec3
    {
        float X{};
        float Y{};
        float Z{};
    };

    // Part of the control block written by Artemis only.
    struct alignas(64) BridgeArtemisControl
    {
        std::uint32_t Magic{};
        std::uint32_t LayoutVersion{};
        std::uint64_t LayoutHash{};
        std::uint32_t RegionSize{};
        std::uint32_t Pid{};
        // Counter Artemis raises about every 50 ms while it is loaded.
        std::uint64_t Heartbeat{};
        // Ticks per second of QueryPerformanceCounter (PublishQpc).
        std::uint64_t QpcFrequency{};
        BridgePhase Phase{};
        // Effective owner.
        BridgeOwner Owner{};
        // Effective mode.
        BridgeMode Mode{};
        // Effective N: a published tick every N action ticks (D114).
        std::uint8_t DecisionPeriod{};
        // Effective d: a decision is applied d action ticks after its decision tick.
        std::uint8_t Latency{};
        std::uint8_t IsClientConnected{};
        // Whether the logic ticks are held (D143): frames run without ticks, the Lockstep wait has no cap.
        std::uint8_t IsPaused{};
        // Engine starts since Artemis loaded. Changes with every match.
        std::uint32_t MatchId{};
        // Last action tick applied by the engine (the clock of the bridge).
        std::uint64_t ActionTick{};
        // Requested time scale in effect (0 = the engine default).
        float Scale{};
        // Tick buffer with the last published tick.
        std::uint32_t ActiveBuffer{};
        // Ticks published since Artemis loaded.
        std::uint64_t PublishedTicks{};
        // Free mode: decisions applied after their tick plus the latency.
        std::uint64_t LateActions{};
        // Ticks the game waited for a decision.
        std::uint64_t LockstepWaits{};
        // Total time the game waited for decisions.
        std::uint64_t LockstepWaitNs{};
        // Waits that hit the cap (the previous decision was kept).
        std::uint64_t LockstepTimeouts{};
        // Actions dropped because their handle is not the player of the slot.
        std::uint64_t HandleMismatches{};
        // Actions with values out of range (fixed before use).
        std::uint64_t RejectedActions{};
        // Ticks read where the action tick did not advance by exactly one (must stay 0). The restart of each match is not one.
        std::uint64_t ClockSkips{};
        // Longest wait for a decision outside a pause.
        std::uint64_t LockstepWaitMaxNs{};
        // Total time spent flattening and publishing ticks (PublishedTicks of them).
        std::uint64_t FlattenNs{};
        // Longest flatten and publish of one tick.
        std::uint64_t FlattenMaxNs{};
        // Game frames that ran without ticks because of a pause.
        std::uint64_t PausedFrames{};
        // Last RequestEndRound seen (D144). Seen is not done: dropped without Python owning the instance or a match running. The proof is the RoundEnd or GameOver event.
        std::uint32_t EndRoundSequence{};
        // Last RequestPreset seen (Q97). PresetResult answers it: Pending until the round break, then Applied or Rejected.
        std::uint32_t PresetSequence{};
        BridgePresetResult PresetResult{};
        // Name of the active gametype preset, zero filled. Empty when none.
        std::array<std::uint8_t, k_BridgePresetNameSize> ActivePreset{};
    };

    // Part of the control block written by Python only.
    struct alignas(64) BridgeClientControl
    {
        std::uint32_t ClientPid{};
        BridgeOwner RequestOwner{};
        BridgeMode RequestMode{};
        // N wanted, 1 to 60 (0 = keep).
        std::uint8_t RequestPeriod{};
        // d wanted, 1 to N (0 = keep).
        std::uint8_t RequestLatency{};
        // Time scale wanted while Python owns the instance (0 = the engine default).
        float RequestScale{};
        // 1 holds the logic ticks while Python owns the instance (D143). Set it before a long step.
        std::uint8_t RequestPause{};
        // Player table indices Python controls, one bit each.
        std::uint32_t AgentMask{};
        // Counter: a raise ends the round, as the end_round action of Megalo (D144). Raises before Artemis takes one count as one. Starts from EndRoundSequence.
        std::uint32_t RequestEndRound{};
        // Counter: a raise asks for the preset RequestPresetName, or none when it is empty (Q97). Taken only while Python owns the instance. Starts from PresetSequence.
        std::uint32_t RequestPreset{};
        // Name of the preset wanted, zero filled. Written before the counter is raised.
        std::array<std::uint8_t, k_BridgePresetNameSize> RequestPresetName{};
        // Most radians the yaw and the pitch of each agent turn per tick toward those of its action (D114). 0 = straight to them.
        float RequestTurnLimit{};
        // Counter Python raises at least every 500 ms.
        std::uint64_t ClientHeartbeat{};
        // Action tick of the last decision whose actions are complete. Written last.
        std::uint64_t ActionSequence{};
    };

    // Control block at the start of the region.
    struct BridgeControl
    {
        BridgeArtemisControl Artemis{};
        BridgeClientControl Client{};
    };

    // What the tick is: which match and which action tick.
    struct BridgeTickHeader
    {
        std::uint32_t MatchId{};
        std::uint16_t PlayerCount{};
        std::uint16_t EntityCount{};
        // Action tick of the state of the tick. Answers carry it as DecisionTick.
        std::uint64_t ActionTick{};
        // Id of the Tick snapshot (not game time).
        std::uint64_t Generation{};
        // QueryPerformanceCounter when the tick was published.
        std::uint64_t PublishQpc{};
        std::uint32_t Flags{};
        // Rows of Events in use, oldest first.
        std::uint16_t EventCount{};
        // Sequence of the newest event of the match up to this tick (0 = none yet).
        std::uint32_t LastEventSequence{};
        // Rows of Objectives in use.
        std::uint16_t ObjectiveCount{};
        // Rows of Stands in use.
        std::uint16_t StandCount{};
        // Rows of Weapons in use.
        std::uint16_t WeaponCount{};
        // Rows of Projectiles in use.
        std::uint16_t ProjectileCount{};
        // MapId of the scnr tag of the loaded map, engine id. 0 while no map.
        std::int32_t MapId{};
        // Rows of Explosives in use.
        std::uint16_t ExplosiveCount{};
        // Rows of Lifts in use.
        std::uint16_t LiftCount{};
    };

    // State of the match (Environment Match, D103).
    struct BridgeMatch
    {
        // Ticks since the start of the match (60 per second). Does not restart between rounds.
        std::uint32_t GameTick{};
        std::uint8_t Phase{};
        std::uint8_t RoundState{};
        // Score of each player, by player table index.
        std::array<std::int16_t, k_MaxPlayers> PlayerScores{};
        // Round of the match, from 0.
        std::int16_t RoundIndex{};
        // Score of each team in the current round, by team.
        std::array<std::int16_t, k_MaxTeams> TeamRoundScores{};
        // Score of each team added up over the match, by team.
        std::array<std::int16_t, k_MaxTeams> TeamTotalScores{};
        // Ticks the round has been played: with a time limit the limit minus the ticks left, without one the stopwatch. Frozen when the round ends, 0 when not known.
        std::uint32_t RoundClockTicks{};
        // Ticks left in the round, 0 once it ran out, -1 when the round has no time limit.
        std::int32_t RoundTicksRemaining{};
        // Time limit of a round in ticks, 0 for none.
        std::uint32_t RoundTimeLimitTicks{};
        // Limit of rounds of the game variant, as stored.
        std::uint8_t RoundLimit{};
        // Score a team (a player in free for all) needs to win, as stored; 0 for none or not known.
        std::int32_t ScoreToWin{};
        // Respawn time of the game variant in ticks, 0 when not known.
        std::uint32_t RespawnTimeTicks{};
        // Sudden death duration in ticks, -1 for indefinite, 0 when not known.
        std::int32_t SuddenDeathTicks{};
        // Grace period of the game variant in ticks.
        std::uint32_t GracePeriodTicks{};
        // Duration of the red, blue and yellow powerups of the game variant in ticks.
        std::array<std::uint32_t, k_BridgePowerupCount> PowerupDurationTicks{};
        // Lives of each player per round, 0 for unlimited.
        std::uint8_t LivesPerRound{};
        // Lives of each team per round, 0 for unlimited.
        std::uint8_t TeamLivesPerRound{};
        // Rounds a team needs to win the match, as stored.
        std::uint8_t RoundsToWin{};
    };

    // One event of the engine (Environment Events, D104). Kind and Key: Semantic.xml (Event, eventkeys).
    struct BridgeEvent
    {
        // From 1 in each match, without gaps. Artemis numbers the events of the log, the ones it generates included.
        std::uint32_t Sequence{};
        // Sequence the engine gave the event in its own ring, 0 in the events Artemis generates (flags).
        std::uint32_t EngineSequence{};
        std::uint32_t GameTick{};
        std::uint32_t Key{};
        std::uint32_t CausePlayer{};
        std::uint32_t CauseObject{};
        std::uint32_t EffectPlayer{};
        std::uint32_t EffectObject{};
        std::uint8_t Kind{};
        std::uint8_t DamageReportingType{};
        std::uint8_t IsHeadshot{};
        std::uint8_t IsStuck{};
    };

    // Traits the engine applies to a player in this tick (Blam.Layout PlayerTraits, D262): already composed with the carried objective, the powerups and the respawn traits. Multipliers are 1.0 for 100%. A raw index outside its table reads NaN (floats), 0 (bools) or Unknown (enums).
    struct BridgePlayerTraits
    {
        // Infinity when invulnerable.
        float DamageResistance{};
        float HealthMultiplier{};
        float HealthRegenRate{};
        float ShieldMultiplier{};
        float ShieldRegenRate{};
        float OvershieldRegenRate{};
        float ShieldVampirism{};
        // Weapon damage. Infinity for instant kill.
        float DamageMultiplier{};
        // Infinity for instant kill.
        float MeleeMultiplier{};
        float MovementSpeed{};
        float Gravity{};
        // Multiplier of the stored percentage (150% reads 1.5).
        float JumpHeight{};
        // Motion tracker range in meters, not a multiplier.
        float RadarRange{};
        // 0 no, 1 yes.
        std::uint8_t HeadshotImmune{};
        // 0 no, 1 yes.
        std::uint8_t AssassinationImmune{};
        // 0 no, 1 yes.
        std::uint8_t CannotDieFromDamage{};
        // 0 no, 1 yes.
        std::uint8_t GrenadeRegen{};
        // 0 no, 1 yes.
        std::uint8_t WeaponPickup{};
        // 0 no, 1 yes.
        std::uint8_t AbilitiesDropOnDeath{};
        // 0 no, 1 yes.
        std::uint8_t InfiniteAbilities{};
        BridgeInfiniteAmmo InfiniteAmmo{};
        BridgeAbilityUsage AbilityUsage{};
        BridgeVehicleUse VehicleUse{};
        BridgeIdentityVisibility VisibleWaypoint{};
        BridgeIdentityVisibility VisibleName{};
        BridgeRadarMode RadarMode{};
        // Grenades the player starts with, 255 for the map default.
        std::uint8_t FragGrenades{};
        // Grenades the player starts with, 255 for the map default.
        std::uint8_t PlasmaGrenades{};
        // Raw setting, 1 off to 5 best.
        std::uint8_t ActiveCamo{};
        // Raw index of the weapon table of the game variant editor, -1 none, 0 the first one.
        std::int8_t PrimaryWeapon{};
        // Raw index of the weapon table of the game variant editor, -1 none.
        std::int8_t SecondaryWeapon{};
        // Raw index of the armor ability table of the game variant editor, -1 none, 0 sprint.
        std::int8_t Ability{};
    };

    // One player of the Tick (Environment Players), without its name.
    struct BridgePlayer
    {
        std::uint32_t Handle{};
        // Biped of the player, NoHandle before the first spawn (the engine stores 0 there) and while there is none.
        std::uint32_t BipedHandle{};
        // Ticks left until the player respawns, 0 while alive (player +0x1BC).
        std::uint32_t RespawnTicks{};
        // Ticks left of the active custom powerup counting this one, 0 when Powerup is None (D263).
        std::uint32_t PowerupTicks{};
        std::uint8_t Team{};
        // Split-screen index, 0xFF when not local.
        std::uint8_t LocalIndex{};
        std::uint8_t Connection{};
        std::uint8_t IsAlive{};
        // Custom powerup the engine applies: 0 none, 1 red, 2 blue, 3 yellow. Also without Body (the engine clears it on death).
        BridgePowerup Powerup{};
        // 0: the fields from Aim on are zero, except the handles of the body, which are NoHandle.
        std::uint8_t HasBody{};
        std::uint8_t Zoom{};
        std::uint8_t SelectedGrenade{};
        std::uint8_t FragGrenades{};
        std::uint8_t PlasmaGrenades{};
        std::uint8_t IsAbilityActive{};
        // Zero in the air and without Body. A contact that cuts for 1 or 2 ticks keeps the last ground.
        BridgeGround Ground{};
        // 1 with contact or in the 2 ticks of a cut that was not a jump, 0 attached and in the air.
        std::uint8_t IsGrounded{};
        // CrouchFraction >= 0.5.
        std::uint8_t IsCrouching{};
        // View of the player, valid for a local player (LocalIndex). In a theater film nobody is local.
        BridgeVec3 CameraPosition{};
        // Unit vector, equal to Aim for a local player with Body. Valid for a local player only.
        BridgeVec3 CameraForward{};
        BridgeVec3 Aim{};
        std::uint32_t TicksAlive{};
        // NaN without shield.
        float Shield{};
        // NoHandle without Body or when there is none.
        std::uint32_t PrimaryWeapon{};
        // NoHandle without Body or when there is none.
        std::uint32_t SecondaryWeapon{};
        // NoHandle without Body or when there is none.
        std::uint32_t EquippedWeapon{};
        // NoHandle without Body or when there is none.
        std::uint32_t Ability{};
        float AbilityEnergy{};
        // NoHandle without Body or when there is none.
        std::uint32_t Objective{};
        // NoHandle without Body or when nobody damaged the player.
        std::uint32_t LastDamagerPlayer{};
        // NoHandle (0xFFFFFFFF) when unknown.
        std::uint32_t TicksSinceDamage{};
        // Ticks without contact in a row, 0 with contact or attached.
        std::uint32_t AirborneTicks{};
        // Object under the feet when Ground is Object, NoHandle otherwise and without Body (the last valid one when the engine drops it).
        std::uint32_t GroundObject{};
        // 0 standing to 1 crouched.
        float CrouchFraction{};
        // Velocity relative to the object under the feet, or the biped's own.
        BridgeVec3 OwnVelocity{};
        // Active traits of the player, also while dead (player +0x328).
        BridgePlayerTraits Traits{};
        // DecisionTick of the bridge action the engine applied to this player up to this tick (0 = none).
        std::uint64_t AppliedDecision{};
    };

    // One live object of the Tick (Environment Entities).
    struct BridgeEntity
    {
        std::uint32_t Handle{};
        std::uint16_t Kind{};
        std::uint8_t Function{};
        std::uint8_t Subtype{};
        std::uint8_t Group{};
        std::uint8_t Lifecycle{};
        std::uint8_t Binding{};
        std::uint8_t Team{};
        std::uint8_t Physics{};
        std::uint16_t Capabilities{};
        std::uint32_t BoundTo{};
        std::uint32_t ParentHandle{};
        // 0 in weapons and projectiles: their tags have no bounding sphere.
        float BoundingRadius{};
        // Fraction of the health, 1 full. NaN without vitality. 0 or below once Lifecycle is Dead: the damage that killed it leaves a negative fraction (-22.2 in a fall).
        float Vitality{};
        BridgeVec3 BoundingCenter{};
        BridgeVec3 WorldOrigin{};
        BridgeVec3 Forward{};
        BridgeVec3 Up{};
        // World space, wu/s. The displacement of the origin in a tick is this over 60. The physics runs at 30 Hz, so it repeats between ticks.
        BridgeVec3 LinearVelocity{};
        BridgeVec3 AngularVelocity{};
    };

    // One flag of a capture game (Perception ObjectiveDetail). One struct per kind, and not one block with a Kind: a stand has three fields and a flag ten, so a shared block would carry seven zero fields per stand.
    struct BridgeObjective
    {
        // Object handle of the flag. The engine recreates the flag on reset, return and capture, so it changes: BaseTeam identifies the flag.
        std::uint32_t Handle{};
        // Player handle of the carrier, NoHandle when none or when the carrier has no player.
        std::uint32_t CarrierPlayer{};
        // Biped handle of the carrier, NoHandle when none.
        std::uint32_t CarrierBiped{};
        // Handle of the stand with the same BaseTeam, NoHandle when none.
        std::uint32_t HomeStand{};
        // Ticks left to reset a dropped flag, rounded up. 0 when it is not dropped or the engine has no timer for it.
        std::uint32_t ResetTicks{};
        // Team of the placement in the map variant. It never changes.
        std::uint8_t BaseTeam{};
        // Team that plays the side of the flag in this round. Neutral when the side is not in use.
        std::uint8_t OwnerTeam{};
        std::uint8_t State{};
        // 1 when the reset timer of a dropped flag is counting down.
        std::uint8_t IsResetRunning{};
        // Live bipeds of players of the OwnerTeam inside the zone of the flag.
        std::uint8_t AlliesInZone{};
    };

    // One flag stand of a capture game (Perception StandDetail).
    struct BridgeStand
    {
        std::uint32_t Handle{};
        std::uint8_t BaseTeam{};
        // Team that plays the side of the stand in this round.
        std::uint8_t OwnerTeam{};
    };

    // Ammo of one magazine of a weapon.
    struct BridgeMagazine
    {
        // Rounds in the weapon, ready to fire.
        std::uint16_t Loaded{};
        // Rounds carried outside the weapon.
        std::uint16_t Reserve{};
    };

    // One live weapon (Perception WeaponDetail): in a hand, on the floor or mounted. The pose, the holder and the team are in its entity.
    struct BridgeWeapon
    {
        std::uint32_t Handle{};
        // Object the weapon tracks, NoHandle when it tracks nothing.
        std::uint32_t TrackedObject{};
        // Energy left, 0 to 1, on an energy weapon. NaN on the others.
        float Energy{};
        // 0 to 1.
        float Heat{};
        // Progress of the charge, 0 to 1. NaN when no trigger of the tag charges.
        float ChargeFraction{};
        // Only the first MagazineCount are meaningful.
        std::array<BridgeMagazine, 2> Magazines{};
        // Magazines of the tag that hold rounds, 0 to 2.
        std::uint8_t MagazineCount{};
        // 1 when the tag has no magazine with rounds.
        std::uint8_t IsEnergyWeapon{};
        // 1 from the overheat until the weapon can fire again, whatever the heat says.
        std::uint8_t IsOverheated{};
        std::uint8_t IsReloading{};
        // Stage of the charged fire mode of trigger 0.
        std::uint8_t ChargeState{};
        // 1 when the tracked object is locked.
        std::uint8_t IsLocked{};
        // 1 when the weapon is not busy, not overheated and has energy or a loaded round. Does not cover the trigger, the holder or a melee.
        std::uint8_t CanFireNow{};
    };

    // One live projectile (Perception ProjectileDetail). The pose and the team are in its entity.
    struct BridgeProjectile
    {
        std::uint32_t Handle{};
        // Player that fired it, NoHandle when none.
        std::uint32_t OwnerPlayer{};
        // Biped that fired it, NoHandle when none.
        std::uint32_t OwnerBiped{};
        // Root of the shooter's parent chain: the biped on foot, the vehicle when seated.
        std::uint32_t ShooterRoot{};
        // Object the projectile is stuck to, NoHandle in flight and while InHand.
        std::uint32_t StuckTo{};
        // Node of StuckTo, -1 when it is not stuck.
        std::int8_t StuckNode{};
        // 1 while a grenade is still in the hand of its thrower.
        std::uint8_t InHand{};
    };

    // One live explosive (Perception ExplosiveDetail): the explosion of its tags. The life, the pose and the team are in its entity.
    struct BridgeExplosive
    {
        std::uint32_t Handle{};
        // Full damage up to this distance, world units. 0 when the tags have no explosion.
        float RadiusMin{};
        // No damage past this distance, world units.
        float RadiusMax{};
        // Damage points at the center, before the material of the victim.
        float Damage{};
    };

    // One stage of a lift: a phantom type of its physics model that pushes players or bipeds (Perception LiftStage).
    struct BridgeLiftStage
    {
        // Marker of the stage, world space. The origin of the lift when the type has no marker.
        BridgeVec3 Position{};
        // +X of the marker, world space. The up of the lift when the type has no marker.
        BridgeVec3 Direction{};
        // Along Direction, wu/s^2.
        float Acceleration{};
        // Along Direction, wu/s. A cap: some lifts release the biped before it reaches it.
        float MaximumVelocity{};
        // Toward the axis of the marker, wu/s^2. Centers the biped.
        float AxisAcceleration{};
        // Toward the axis of the marker, wu/s.
        float AxisMaximumVelocity{};
        // Bits: 1 players, 2 bipeds that are not players, 4 vehicles, 8 items (weapons, equipment, crates).
        std::uint8_t Affects{};
    };

    // One live lift (Perception LiftDetail): the stages of its tag and the measured exit of the last biped it pushed. The pose and the team are in its entity.
    struct BridgeLift
    {
        std::uint32_t Handle{};
        // Stages in use, 0 to MaxLiftStages. 0 without definitions or physics model.
        std::uint8_t StageCount{};
        // 1 once a biped has left the push of this lift. ExitTick, ExitBiped and ExitVelocity mean nothing before.
        std::uint8_t HasExit{};
        // GameTick of the first tick with the biped out of the volume.
        std::uint32_t ExitTick{};
        // Biped that left, NoHandle without an exit.
        std::uint32_t ExitBiped{};
        // Linear velocity of the biped at ExitTick, world space, wu/s. The last exit replaces the previous one.
        BridgeVec3 ExitVelocity{};
        // Only the first StageCount are meaningful, in the order of the tag.
        std::array<BridgeLiftStage, k_BridgeMaxLiftStages> Stages{};
    };

    // One flattened Tick. Sequence and SequenceEnd are equal and even when the tick is complete.
    struct alignas(64) BridgeTick
    {
        std::uint64_t Sequence{};
        BridgeTickHeader Header{};
        std::array<BridgePlayer, k_MaxPlayers> Players{};
        std::array<BridgeEntity, k_MaxObjects> Entities{};
        BridgeMatch Match{};
        // Flags, sorted by BaseTeam then Handle.
        std::array<BridgeObjective, k_BridgeMaxObjectives> Objectives{};
        // Stands, sorted by BaseTeam then Handle.
        std::array<BridgeStand, k_BridgeMaxObjectives> Stands{};
        std::array<BridgeEvent, k_BridgeMaxTickEvents> Events{};
        // Live weapons, sorted by Handle.
        std::array<BridgeWeapon, k_BridgeMaxWeapons> Weapons{};
        // Live projectiles, sorted by Handle.
        std::array<BridgeProjectile, k_BridgeMaxProjectiles> Projectiles{};
        // Live explosives, sorted by Handle.
        std::array<BridgeExplosive, k_BridgeMaxExplosives> Explosives{};
        // Live lifts, sorted by Handle.
        std::array<BridgeLift, k_BridgeMaxLifts> Lifts{};
        std::uint64_t SequenceEnd{};
    };

    // Action of one player for one decision, written by Python (D109, D119).
    struct BridgeAction
    {
        // Full handle of the player of the slot (D40). Another handle drops the action.
        std::uint32_t PlayerHandle{};
        // Down bits of the hold lanes (D121).
        std::uint32_t Lanes{};
        // ActionTick of the tick this action answers. Written 0 first, then the fields, then the tick.
        std::uint64_t DecisionTick{};
        std::uint64_t Buttons{};
        // Absolute, radians.
        float Yaw{};
        // Absolute, radians.
        float Pitch{};
        // -1 to 1.
        float ThrottleForward{};
        // -1 to 1.
        float ThrottleLeft{};
        std::uint8_t Requests{};
    };

    // The whole shared memory of one instance.
    struct BridgeRegion
    {
        BridgeControl Control{};
        std::array<BridgeTick, k_BridgeTickBuffers> Ticks{};
        alignas(64) std::array<BridgeAction, k_MaxPlayers> Actions{};
    };

