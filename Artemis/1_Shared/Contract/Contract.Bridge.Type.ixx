    static_assert(offsetof(BridgeArtemisControl, Heartbeat) == 24);
    static_assert(offsetof(BridgeArtemisControl, QpcFrequency) == 32);
    static_assert(offsetof(BridgeArtemisControl, Phase) == 40);
    static_assert(offsetof(BridgeArtemisControl, Owner) == 41);
