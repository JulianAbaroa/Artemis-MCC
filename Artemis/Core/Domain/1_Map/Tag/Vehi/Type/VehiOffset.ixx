        constexpr std::size_t k_DamageSourceRegionName                      = 0x30;  // StringID.
        constexpr std::size_t k_DefaultStateError                           = 0x34;  // float32.
        constexpr std::size_t k_MinorDamageError                            = 0x38;  // float32.
        constexpr std::size_t k_MediumDamageError                           = 0x3C;  // float32.
        constexpr std::size_t k_MajorDamageError                            = 0x40;  // float32.
        constexpr std::size_t k_DestroyedStateError                         = 0x44;  // float32.

        constexpr std::size_t EntryOffset(std::size_t index)
        {
            return k_Base + (index * k_EntrySize);
        }
    }

    namespace FrictionPoints
    {
        // Array data.
        constexpr std::size_t k_Base      = 0x5C8;
        constexpr std::size_t k_EntrySize = 0x34;

        constexpr std::size_t k_MarkerName                                  = 0x0;  // StringID.
        constexpr std::size_t k_Flags                                       = 0x4;  // flags32. [Gets Damage From Region=0, Powered=1, Front Turning=2, Rear Turning=3, AI Force Rear Turning=4, Attached To E-Brake=5, Can Be Destroyed=6, Bit 7=7, Bit 8=8, Bit 9=9, Bit 10=10, Bit 11=11, Bit 12=12, Bit 13=13, Bit 14=14, Bit 15=15, Bit 16=16, Bit 17=17, Bit 18=18, Bit 19=19, Bit 20=20, Bit 21=21, Bit 22=22, Bit 23=23, Bit 24=24, Bit 25=25, Bit 26=26, Bit 27=27, Bit 28=28, Bit 29=29, Bit 30=30, Bit 31=31]
        constexpr std::size_t k_FractionOfTotalMass                         = 0x8;  // float32.
        constexpr std::size_t k_Radius                                      = 0xC;  // float32.
        constexpr std::size_t k_DamagedRadius                               = 0x10;  // float32.
        constexpr std::size_t k_MovingFrictionVelocityDifferential          = 0x14;  // float32.
        constexpr std::size_t k_EBrakeMovingFriction                        = 0x18;  // float32.
        constexpr std::size_t k_EBrakeFriction                              = 0x1C;  // float32.
        constexpr std::size_t k_EBrakeMovingFrictionVelocityDifferential    = 0x20;  // float32.
        constexpr std::size_t k_CollisionGlobalMaterialName                 = 0x24;  // StringID.
        constexpr std::size_t k_CollisionGlobalMaterialIndex                = 0x28;  // int16.
        constexpr std::size_t k_ModelStateDestroyed                         = 0x2A;  // enum16. [Default=0x0, Minor Damage=0x1, Medium Damage=0x2, Major Damage=0x3, Destroyed=0x4]
        constexpr std::size_t k_RegionName                                  = 0x2C;  // StringID.
        constexpr std::size_t k_RegionIndex                                 = 0x30;  // int32.

        constexpr std::size_t EntryOffset(std::size_t index)
        {
            return k_Base + (index * k_EntrySize);
        }
    }

    constexpr std::size_t k_GroundVerticalExtrusion                     = 0x5D4;  // float32.
    namespace Tricks
    {
        // Array data.
        constexpr std::size_t k_Base      = 0x5D8;
        constexpr std::size_t k_EntrySize = 0x20;

        constexpr std::size_t k_AnimationName                               = 0x0;  // StringID.
        constexpr std::size_t k_ActivationType                              = 0x4;  // enum8. [Brake + Left=0x0, Brake + Right=0x1, Brake + Up=0x2, Brake + Down=0x3]
        constexpr std::size_t k_VelocityPreservation                        = 0x5;  // enum8. [None=0x0, Trick Relative=0x1, World Relative=0x2]
        constexpr std::size_t k_Flags                                       = 0x6;  // flags8. [Use Following Camera=0, Do Not Slam Player Control=1]
        constexpr std::size_t k_Unknown                                     = 0x7;  // int8.
        constexpr std::size_t k_CameraInterpolationTime                     = 0x8;  // float32.
        constexpr std::size_t k_TrickExitTime                               = 0xC;  // float32.
        constexpr std::size_t k_TrickExitCameraInterpolationTime            = 0x10;  // rangef.
        constexpr std::size_t k_TrickExitDisplacementReference              = 0x18;  // float32.
        constexpr std::size_t k_CooldownTime                                = 0x1C;  // float32.

        constexpr std::size_t EntryOffset(std::size_t index)
        {
            return k_Base + (index * k_EntrySize);
        }
    }

