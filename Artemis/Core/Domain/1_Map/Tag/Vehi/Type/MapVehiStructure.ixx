        float        BlurSpeed;  // 0x600  float32.
        std::uint32_t FlipMessage;  // 0x604  stringid.
        MapStructure::Tag::Reference SuspensionSound;  // 0x608  tagref.
        MapStructure::Tag::Reference SpecialEffect;  // 0x618  tagref.
        MapStructure::Tag::Reference DriverBoostDamageEffectOrResponse;  // 0x628  tagref.
        MapStructure::Tag::Reference RiderBoostDamageEffectOrResponse;  // 0x638  tagref.
    };
    static_assert(sizeof(VehiData) == 0x648, "VehiData size mismatch");

}

#pragma pack(pop)
