        float        AutolevelSpringK;  // 0x80  float32. | controls relationship between displacement and acceleration - higher values mean faster acceleration when the desired position is far from current position
        float        AutolevelSpringC;  // 0x84  float32. | controls relationship between velocity and friction - higher values will slow the system down, lower values may let the system oscillate
        float        CosmeticRollScale;  // 0x88  float32. | desired roll = delta yaw X scale
        float        CosmeticRollMaximumBank;  // 0x8C  degree. | maximum cosmetic roll angle
        float        CosmeticRollMaximumVelocity;  // 0x90  degree. | maximum angular velocity that cosmetic roll can achieve
        float        CosmeticRollAcceleration;  // 0x94  degree. | maximum angular acceleration for cosmetic roll
        float        CosmeticRollSpringK;  // 0x98  float32. | controls relationship between displacement and acceleration - higher values mean faster acceleration when the desired position is far from current position
        float        CosmeticRollSpringC;  // 0x9C  float32. | controls relationship between velocity and friction - higher values will slow the system down, lower values may let the system oscillate
        float        TurnDecelerationThreshold;  // 0xA0  degree. | turn deceleration kicks in when turning faster than this
        float        TurnDecelerationFraction;  // 0xA4  float32. | when turning at the maximum rate, throttle is limited to this value
        std::uint32_t TurnBackFlags;  // 0xA8  flags32. [Turn Back To Tangent=0]
        float        TurnBackLatchedPeriod;  // 0xAC  float32.
        MapStructure::Data::Reference TurnBackDistanceToTurnRateFunction;  // 0xB0  dataref.
    };
