        float        RollAcceleration;  // 0x60  degree. | acceleration for user-input roll
        float        RollDeceleration;  // 0x64  degree. | deceleration for user-input roll (when the user releases the stick)
        float        RollSmoothingFraction;  // 0x68  float32. | if non-zero, when the desired velocity change is less than this fraction of the acceleration, starts interpolating the maximum acceleration towards zero. You can think of this as a time in seconds where if the velocity would reach its target in this amount of time or less, it will start taking longer.
        float        AutolevelTime;  // 0x6C  float32. | how long you must not rotate (roll, pitch, yaw) before autoleveling kicks in
        float        AutolevelPitchCutoff;  // 0x70  degree. | if the ship is pitched outside of this range, autoleveling will not happen. The effect is also scaled as the pitch approaches this angle
        float        AutolevelMaximumVelocity;  // 0x74  degree. | maximum angular velocity for autoleveling
        float        AutolevelMaximumAcceleration;  // 0x78  degree. | maximum acceleration for autoleveling
