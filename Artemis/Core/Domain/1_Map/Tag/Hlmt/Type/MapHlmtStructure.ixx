        std::uint32_t Flags_2;  // 0x15C  flags32. [Active Camo Always On=0, Active Camo Never=1, Inconsequential Target=2, Model Use Airprobe Lighting First=3, Locked Precomputed Probes=4, If Sky Attaches To Camera=5, Model Is Big Battle Object=6, Model Never Uses Compressed Vertex Position=7, Model Is Invisible, Even Attachments=8, Model Can Have Shield Impact Effect=9, Model Is Good z Occluder=10, No Child Objects In Lightmap Shadow=11, Should Include Model In Floating Shadow=12, Bit 13=13, Damage Section Unknown?=14, Damage Section Recharging?=15, ...(32 total)]
        std::uint32_t DefaultDialogueEffect;  // 0x160  stringid. | The default dialogue tag for this model (overriden by variants)
        std::uint32_t RenderOnlyNodeFlags1;  // 0x164  flags32. [Node 0=0, Node 1=1, Node 2=2, Node 3=3, Node 4=4, Node 5=5, Node 6=6, Node 7=7, Node 8=8, Node 9=9, Node 10=10, Node 11=11, Node 12=12, Node 13=13, Node 14=14, Node 15=15, ...(32 total)]
        std::uint32_t RenderOnlyNodeFlags2;  // 0x168  flags32. [Node 32=0, Node 33=1, Node 34=2, Node 35=3, Node 36=4, Node 37=5, Node 38=6, Node 39=7, Node 40=8, Node 41=9, Node 42=10, Node 43=11, Node 44=12, Node 45=13, Node 46=14, Node 47=15, ...(32 total)]
        std::uint32_t RenderOnlyNodeFlags3;  // 0x16C  flags32. [Node 64=0, Node 65=1, Node 66=2, Node 67=3, Node 68=4, Node 69=5, Node 70=6, Node 71=7, Node 72=8, Node 73=9, Node 74=10, Node 75=11, Node 76=12, Node 77=13, Node 78=14, Node 79=15, ...(32 total)]
        std::uint32_t RenderOnlyNodeFlags4;  // 0x170  flags32. [Node 96=0, Node 97=1, Node 98=2, Node 99=3, Node 100=4, Node 101=5, Node 102=6, Node 103=7, Node 104=8, Node 105=9, Node 106=10, Node 107=11, Node 108=12, Node 109=13, Node 110=14, Node 111=15, ...(32 total)]
        std::uint32_t RenderOnlyNodeFlags5;  // 0x174  flags32. [Node 128=0, Node 129=1, Node 130=2, Node 131=3, Node 132=4, Node 133=5, Node 134=6, Node 135=7, Node 136=8, Node 137=9, Node 138=10, Node 139=11, Node 140=12, Node 141=13, Node 142=14, Node 143=15, ...(32 total)]
        std::uint32_t RenderOnlyNodeFlags6;  // 0x178  flags32. [Node 160=0, Node 161=1, Node 162=2, Node 163=3, Node 164=4, Node 165=5, Node 166=6, Node 167=7, Node 168=8, Node 169=9, Node 170=10, Node 171=11, Node 172=12, Node 173=13, Node 174=14, Node 175=15, ...(32 total)]
        std::uint32_t RenderOnlyNodeFlags7;  // 0x17C  flags32. [Node 192=0, Node 193=1, Node 194=2, Node 195=3, Node 196=4, Node 197=5, Node 198=6, Node 199=7, Node 200=8, Node 201=9, Node 202=10, Node 203=11, Node 204=12, Node 205=13, Node 206=14, Node 207=15, ...(32 total)]
        std::uint32_t RenderOnlyNodeFlags8;  // 0x180  flags32. [Node 224=0, Node 225=1, Node 226=2, Node 227=3, Node 228=4, Node 229=5, Node 230=6, Node 231=7, Node 232=8, Node 233=9, Node 234=10, Node 235=11, Node 236=12, Node 237=13, Node 238=14, Node 239=15, ...(32 total)]
        std::uint32_t RenderOnlySectionFlags1;  // 0x184  flags32. [Section 0=0, Section 1=1, Section 2=2, Section 3=3, Section 4=4, Section 5=5, Section 6=6, Section 7=7, Section 8=8, Section 9=9, Section 10=10, Section 11=11, Section 12=12, Section 13=13, Section 14=14, Section 15=15, ...(32 total)]
        std::uint32_t RenderOnlySectionFlags2;  // 0x188  flags32. [Section 32=0, Section 33=1, Section 34=2, Section 35=3, Section 36=4, Section 37=5, Section 38=6, Section 39=7, Section 40=8, Section 41=9, Section 42=10, Section 43=11, Section 44=12, Section 45=13, Section 46=14, Section 47=15, ...(32 total)]
        std::uint32_t RenderOnlySectionFlags3;  // 0x18C  flags32. [Section 64=0, Section 65=1, Section 66=2, Section 67=3, Section 68=4, Section 69=5, Section 70=6, Section 71=7, Section 72=8, Section 73=9, Section 74=10, Section 75=11, Section 76=12, Section 77=13, Section 78=14, Section 79=15, ...(32 total)]
        std::uint32_t RenderOnlySectionFlags4;  // 0x190  flags32. [Section 96=0, Section 97=1, Section 98=2, Section 99=3, Section 100=4, Section 101=5, Section 102=6, Section 103=7, Section 104=8, Section 105=9, Section 106=10, Section 107=11, Section 108=12, Section 109=13, Section 110=14, Section 111=15, ...(32 total)]
        std::uint32_t RenderOnlySectionFlags5;  // 0x194  flags32. [Section 128=0, Section 129=1, Section 130=2, Section 131=3, Section 132=4, Section 133=5, Section 134=6, Section 135=7, Section 136=8, Section 137=9, Section 138=10, Section 139=11, Section 140=12, Section 141=13, Section 142=14, Section 143=15, ...(32 total)]
        std::uint32_t RenderOnlySectionFlags6;  // 0x198  flags32. [Section 160=0, Section 161=1, Section 162=2, Section 163=3, Section 164=4, Section 165=5, Section 166=6, Section 167=7, Section 168=8, Section 169=9, Section 170=10, Section 171=11, Section 172=12, Section 173=13, Section 174=14, Section 175=15, ...(32 total)]
        std::uint32_t RenderOnlySectionFlags7;  // 0x19C  flags32. [Section 192=0, Section 193=1, Section 194=2, Section 195=3, Section 196=4, Section 197=5, Section 198=6, Section 199=7, Section 200=8, Section 201=9, Section 202=10, Section 203=11, Section 204=12, Section 205=13, Section 206=14, Section 207=15, ...(32 total)]
        std::uint32_t RenderOnlySectionFlags8;  // 0x1A0  flags32. [Section 224=0, Section 225=1, Section 226=2, Section 227=3, Section 228=4, Section 229=5, Section 230=6, Section 231=7, Section 232=8, Section 233=9, Section 234=10, Section 235=11, Section 236=12, Section 237=13, Section 238=14, Section 239=15, ...(32 total)]
        std::uint32_t RuntimeFlags;  // 0x1A4  flags32. [Contains Runtime Nodes=0]
        // -> Hlmt_ScenarioLoadParametersEntry[]
        MapStructure::Tag::Block   ScenarioLoadParameters;  // 0x1A8  tagblock.
        float        SkyParallaxPercent;  // 0x1B4  float32. | If flag checked % between sky pos and camera pos 0=camera
        float        ShadowDepthCompareBias;  // 0x1B8  float32. | Default is 0.002
        float        ShadowSlopeScaleBias;  // 0x1BC  float32. | controls cutoff point for shadows around edges. Default is 81 degrees
        float        ShadowDepthCompareBiasDynamicLights;  // 0x1C0  float32. | Default is 0.0008
        float        ShadowSlopeScaleBiasDynamicLights;  // 0x1C4  float32. | controls cutoff point for shadows around edges. Default is 81 degrees
        std::uint8_t PrtShadowDetail;  // 0x1C8  enum8. [Ambient Occlusion (2 Bytes Per Vertex)=0x0, Linear (8 Bytes Per Vertex)=0x1, Quadratic (18 Bytes Per Vertex)=0x2] | how much information is recorded about different light directions
        std::uint8_t PrtShadowBounces;  // 0x1C9  enum8. [0 Bounces (Very Fast, Direct Light Only)=0x0, 1 Bounce (Slower, Pretty Good)=0x1, 2 Bounces (Molasses, Very Good)=0x2, 3 Bounces (Sloth In Molasses, Overkill Really)=0x3] | 0 means direct light only
        std::int16_t Unknown_3;  // 0x1CA  int16.
        // -> Hlmt_ShadowCastOverrideEntry[]
        MapStructure::Tag::Block   ShadowCastOverride;  // 0x1CC  tagblock.
        // -> Hlmt_ShadowReceiveOverrideEntry[]
        MapStructure::Tag::Block   ShadowReceiveOverride;  // 0x1D8  tagblock.
        // -> Hlmt_OcclusionSpheresEntry[]
        MapStructure::Tag::Block   OcclusionSpheres;  // 0x1E4  tagblock.
        MapStructure::Tag::Reference ShieldImpactParameterOverride;  // 0x1F0  tagref.
        MapStructure::Tag::Reference _1stPersonShieldImpactParameterOverride;  // 0x200  tagref.
        float        BoundingRadius;  // 0x210  float32.
        MapStructure::Primitive::Vec3 BoundingOffset;  // 0x214  point3.
    };
    static_assert(sizeof(HlmtData) == 0x220, "HlmtData size mismatch");

}

#pragma pack(pop)
