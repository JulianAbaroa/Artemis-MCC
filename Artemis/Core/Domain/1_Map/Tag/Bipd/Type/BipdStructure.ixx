        float        BoostFallTime;  // 0x488  float32. | if the trigger is let go (or peak time expires), takes this long to reach 0 power
        float        BoostPowerPerSecond;  // 0x48C  float32. | 1, means you burn all your power in one sec. .1 means you can boost for 10 seconds.
        float        BoostRechargeRate;  // 0x490  float32. | 1 means you recharge fully in 1 second. .1 means you rechage fully in 10 seconds
        float        BoostRechargeDelay;  // 0x494  float32. | how long do you have to be off the tirgger for before boost starts recharging
        MapStructure::Data::Reference TriggerToBoostFunction;  // 0x498  dataref.
        MapStructure::Tag::Reference ExitAndDetachDamage;  // 0x4AC  tagref.
        MapStructure::Tag::Reference ExitAndDetachWeapon;  // 0x4BC  tagref.
        float        MovingTurningSpeed;  // 0x4CC  degree.
        std::uint32_t Flags_5;  // 0x4D0  flags32. [Turns Without Animating=0, Has Physical Rigid Bodies When Alive=1, Immune To Falling Damage=2, Has Animated Jetpack=3, Bit 4=4, Bit 5=5, Random Speed Increase=6, Bit 7=7, Spawn Death Children On Destroy=8, Stunned By EMP Damage=9, Dead Physics When Stunned=10, Always Ragdoll When Dead=11, Bit 12=12, Bit 13=13, Bit 14=14, Bit 15=15, ...(32 total)]
        float        StationaryTurningThreshold;  // 0x4D4  degree.
        MapStructure::Tag::Reference DeathProgramSelector;  // 0x4D8  tagref.
        std::uint32_t RagdollRegionName;  // 0x4E8  stringid. | when the biped transitions to ragdoll, this region will change to the destroyed state
        std::uint32_t AssassinationChudText;  // 0x4EC  stringid. | The string id for the assassination action text in the CHUD
        float        JumpVelocity;  // 0x4F0  float32.
        // -> Bipd_TricksEntry[]
        MapStructure::Tag::Block   Tricks;  // 0x4F4  tagblock.
        std::uint8_t  _pad_0x500[0x4];  // undefined.
        std::uint8_t  _pad_0x504[0x4];  // undefined.
        std::uint8_t  _pad_0x508[0x4];  // undefined.
        float        MaximumSoftLandingTime;  // 0x50C  float32. | the longest amount of time the biped can take to recover from a soft landing
        float        MaximumHardLandingTime;  // 0x510  float32. | the longest amount of time the biped can take to recover from a hard landing
        float        MinimumSoftLandingVelocity;  // 0x514  float32. | below this velocity the biped does not react when landing
        float        MinimumHardLandingVelocity;  // 0x518  float32. | below this velocity the biped will not do a soft landing when returning to the ground
        float        MaximumHardLandingVelocity;  // 0x51C  float32. | the velocity corresponding to the maximum landing time
        float        StunDuration;  // 0x520  float32. | 0 is the default. Bipeds are stunned when damaged by vehicle collisions, also some are when they take emp damage
        float        StandingCameraHeight;  // 0x524  float32.
        float        RunningCameraHeight;  // 0x528  float32.
        float        CrouchingCameraHeight;  // 0x52C  float32.
        float        CrouchWalkingCameraHeight;  // 0x530  float32.
        float        CrouchTransitionTime;  // 0x534  float32.
        MapStructure::Data::Reference CameraHeightVelocityFunction;  // 0x538  dataref.
        // -> Bipd_CameraHeightsEntry[]
        MapStructure::Tag::Block   CameraHeights;  // 0x54C  tagblock.
        float        CameraInterpolationStart;  // 0x558  degree. | looking-downward angle that starts camera interpolation to fp position
        float        CameraInterpolationEnd;  // 0x55C  degree. | looking-downward angle at which camera interpolation to fp position is complete
        MapStructure::Primitive::Vec3 CameraOffset;  // 0x560  vector3. | amount of fp camera movement in (forward, right, down) when pitched down by 'camera interpolation end' above
        float        RootOffsetCameraScale;  // 0x56C  float32.
        float        RootOffsetCameraDampening;  // 0x570  float32.
        float        AutoaimWidth;  // 0x574  float32.
        std::int16_t PhysicsControlNodeIndex;  // 0x578  int16.
        std::int16_t Unknown_4;  // 0x57A  int16.
        float        CosineStationaryTurningThreshold;  // 0x57C  float32.
        float        CrouchTransitionVelocity;  // 0x580  float32.
        float        CameraHeightVelocity;  // 0x584  float32.
        std::int16_t PelvisNodeIndex;  // 0x588  int16.
        std::int16_t HeadNodeIndex;  // 0x58A  int16.
        // -> Bipd_WallProximityFeelersEntry[]
        MapStructure::Tag::Block   WallProximityFeelers;  // 0x58C  tagblock.
        MapStructure::Tag::Reference AreaDamageEffect;  // 0x598  tagref.
        MapStructure::Tag::Reference HealthStationRechargeEffect;  // 0x5A8  tagref.
        // -> Bipd_MovementGatesEntry[]
        MapStructure::Tag::Block   MovementGates;  // 0x5B8  tagblock.
        // -> Bipd_MovementGatesCrouchingEntry[]
        MapStructure::Tag::Block   MovementGatesCrouching;  // 0x5C4  tagblock.
        float        JumpAimOffsetDistance;  // 0x5D0  float32.
        float        JumpAimOffsetDuration;  // 0x5D4  float32.
        float        LandAimOffsetDistance;  // 0x5D8  float32.
        float        LandAimOffsetDuration;  // 0x5DC  float32.
        float        AimCompensateMinimumDistance;  // 0x5E0  float32.
        float        AimCompensateMaximumDistance;  // 0x5E4  float32.
        std::uint32_t Flags_6;  // 0x5E8  flags32. [Centered At Origin=0, Shape Spherical=1, Use Player Physics=2, Climb Any Surface=3, Flying=4, Not Physical=5, Dead Character Collision Group=6, Suppress Ground Planes On Bipeds=7, Physical Ragdoll=8, Do Not Resize Dead Spheres=9, Bit 10=10, Bit 11=11, Bit 12=12, Bit 13=13, Bit 14=14, Bit 15=15, ...(32 total)]
        float        HeightStanding;  // 0x5EC  float32.
        float        HeightCrouching;  // 0x5F0  float32.
        float        Radius;  // 0x5F4  float32.
        float        Mass;  // 0x5F8  float32.
        std::uint32_t LivingGlobalMaterialName;  // 0x5FC  stringid. | collision material used when character is alive
        std::uint32_t DeadGlobalMaterialName;  // 0x600  stringid. | collision material used when character is dead
        std::int16_t LivingGlobalMaterialIndex;  // 0x604  int16.
        std::int16_t DeadGlobalMaterialIndex;  // 0x606  int16.
        // -> Bipd_DeadSphereShapesEntry[]
        MapStructure::Tag::Block   DeadSphereShapes;  // 0x608  tagblock.
        // -> Bipd_PillShapesEntry[]
        MapStructure::Tag::Block   PillShapes;  // 0x614  tagblock.
        // -> Bipd_SphereShapesEntry[]
        MapStructure::Tag::Block   SphereShapes;  // 0x620  tagblock.
        float        MaximumSlopeAngle;  // 0x62C  degree.
        float        DownhillFalloffAngle;  // 0x630  degree.
        float        DownhillCutoffAngle;  // 0x634  degree.
        float        UphillFalloffAngle;  // 0x638  degree.
        float        UphillCutoffAngle;  // 0x63C  degree.
        float        DownhillVelocityScale;  // 0x640  float32.
        float        UphillVelocityScale;  // 0x644  float32.
        float        CosineMaximumSlopeAngle;  // 0x648  float32.
        float        NegativeSineDownhillFalloffAngle;  // 0x64C  float32.
        float        NegativeSineDownhillCutoffAngle;  // 0x650  float32.
        float        SineUphillFalloffAngle;  // 0x654  float32.
        float        SineUphillCutoffAngle;  // 0x658  float32.
        float        ClimbInflectionAngle;  // 0x65C  degree. | angle for bipeds at which climb direction changes between up and down
        float        AirborneReactionTimeScale;  // 0x660  float32. | scale on the time for the entity to realize it is airborne
        float        GroundAdhesionVelocityScale;  // 0x664  float32. | scale on velocity with which the entity is pushed back into its ground plane (set to -1 to lock to ground)
        float        GravityScale;  // 0x668  float32. | scale on gravity for this entity
        float        AirborneAccelerationScale;  // 0x66C  float32. | scale on airborne acceleration maximum
        float        BankAngle;  // 0x670  degree. | angle at which we bank left/right when sidestepping or turning while moving forwards
        float        BankApplyTime;  // 0x674  float32. | time it takes us to apply a bank
        float        BankDecayTime;  // 0x678  float32. | time it takes us to recover from a bank
        float        PitchRatio;  // 0x67C  float32. | amount that we pitch up/down when moving up or down
        float        MaximumVelocity;  // 0x680  float32. | max velocity when not crouching
        float        MaximumSidestepVelocity;  // 0x684  float32. | max sideways or up/down velocity when not crouching
        float        Acceleration;  // 0x688  float32.
        float        Deceleration;  // 0x68C  float32.
        float        AngularVelocityMaximum;  // 0x690  degree. | turn rate
        float        AngularAccelerationMaximum;  // 0x694  degree. | turn acceleration rate
        float        CrouchVelocityModifier;  // 0x698  float32. | how much slower we fly if crouching (zero = same speed)
        std::uint32_t Flags_7;  // 0x69C  flags32. [Use World Up=0]
        // -> Bipd_ContactPointsEntry[]
        MapStructure::Tag::Block   ContactPoints;  // 0x6A0  tagblock. | these are the points where the biped touches the ground
        MapStructure::Tag::Reference ReanimationCharacter;  // 0x6AC  tagref. | when the flood reanimate this guy, he turns into a ...
        MapStructure::Tag::Reference ReanimationMorphMuffins;  // 0x6BC  tagref. | the kind of muffins I create to cover my horrible transformation
        MapStructure::Tag::Reference DeathSpawnCharacter;  // 0x6CC  tagref. | when I die, out of the ashes of my death crawls a ...
        std::int16_t DeathSpawnCount;  // 0x6DC  int16.
        std::int16_t Unknown_5;  // 0x6DE  int16.
        std::uint32_t LeapFlags;  // 0x6E0  flags32. [Force Early Roll=0]
        float        DampeningScale;  // 0x6E4  float32. | [0,1] 1= very slow changes
        float        RollDelay;  // 0x6E8  float32. | [0,1] 1= roll fast and late
        float        CannonballOffAxisScale;  // 0x6EC  float32. | [0,1] weight
        float        CannonballOffTrackScale;  // 0x6F0  float32. | [0,1] weight
        MapStructure::Primitive::RangeF CannonballRollBounds;  // 0x6F4  ranged. | degrees per second
        MapStructure::Primitive::RangeF AnticipationRatioBounds;  // 0x6FC  rangef. | current velocity/leap velocity
        MapStructure::Primitive::RangeF ReactionForceBounds;  // 0x704  rangef. | units per second
        float        LobbingDesire;  // 0x70C  float32. | 1= heavy arc, 0= no arc
        std::uint32_t Flags_8;  // 0x710  flags32. [Foot Fixup Enabled=0, Root Offset Enabled=1, Free Foot Enabled=2, z Leg Enabled=3, Foot Pull Pinned=4, Footlock Adjusts Root=5, Raycast Vehicles=6, Foot Fixup On Composites=7, Allow Feet Below Grade=8, Use Biped Up Direction=9, Snap Marker Above Contact=10]
        float        GroundNormalDampening;  // 0x714  float32. | react to slope changes (0=slow, 1= fast)
        float        RootOffsetMaximumScaleIdle;  // 0x718  float32. | vertical drop to ground allowed (0=none, 1=full)
        float        RootOffsetMaximumScaleMoving;  // 0x71C  float32. | vertical drop to ground allowed (0=none, 1=full)
        float        RootOffsetDampening;  // 0x720  float32. | react to root changes (0=slow, 1= fast)
        float        FollowingCameraScale;  // 0x724  float32. | root offset effect on following cam (0=none, 1=full)
        float        RootLeaningScale;  // 0x728  float32. | lean into slopes (0=none, 1=full)
        float        StanceWidthScale;  // 0x72C  float32. | scale pill width to use as stance radius
        float        FootRollMaximum;  // 0x730  degree. | orient to ground slope (degrees)
        float        FootPitchMaximum;  // 0x734  degree. | orient to ground slope (degrees)
        float        FootNormalDampening;  // 0x738  float32. | (0=slow, 1= fast)
        float        FootFittingTestDistance;  // 0x73C  float32.
        float        FootDisplacementUpwardDampening;  // 0x740  float32. | (0=slow, 1= fast)
        float        FootDisplacementDownwardDampening;  // 0x744  float32. | (0=slow, 1= fast)
        float        FootPullThresholdDistanceIdle;  // 0x748  float32. | amount past the authored plane the foot can be pulled (wu)
        float        FootPullThresholdDistanceMoving;  // 0x74C  float32. | amount past the authored plane the foot can be pulled (wu)
        float        FootTurnMinimumRadius;  // 0x750  float32. | minimum radius at which foot is fit to turn radius
        float        FootTurnMaximumRadius;  // 0x754  float32. | maximum radius at which foot is fit to turn radius
        float        FootTurnThresholdRadius;  // 0x758  float32. | foot is fit to turn radius fully at minimum plus threshold and above
        float        FootTurnRateDampening;  // 0x75C  float32. | (0=slow, 1= fast)
        float        FootTurnWeightDampening;  // 0x760  float32. | dampening of fitting value for fit to turn radius(0=none, 1=fast)
        float        FootTurnBlendOnTime;  // 0x764  float32. | time to blend on the foot turn effect (seconds)
        float        FootTurnBlendOffTime;  // 0x768  float32. | time to blend off the foot turn effect (seconds)
        float        Unknown_6;  // 0x76C  float32.
        float        Unknown_7;  // 0x770  degree.
        float        PivotOnFootScale;  // 0x774  float32. | (0=none, 1=full)
        float        PivotMinimumFootDelta;  // 0x778  float32. | vert world units to find lowest foot
        float        PivotStrideLengthScale;  // 0x77C  float32. | leg length * this = stride length
        float        PivotThrottleScale;  // 0x780  float32. | pivoting slows throttle (0=none, 1= full)
        float        PivotOffsetDampening;  // 0x784  float32. | react to pivot changes (0=slow, 1= fast)
    };
    static_assert(sizeof(BipdData) == 0x788, "BipdData size mismatch");

}

#pragma pack(pop)
